# Copie para .env e preencha. O .env real NÃO é versionado.

# Obrigatório em produção (APP_ENV=production): sem ele o boot falha.
# Em desenvolvimento, se vazio, é gerado um valor aleatório por processo.
SECRET_KEY=

# development | production
APP_ENV=development

HOST=127.0.0.1
PORT=5000
DEBUG=false

DATABASE_PATH=loja.db
CORS_ORIGINS=*

# Validade, em segundos, do token emitido por POST /login.
TOKEN_TTL_SECONDS=3600

APP_VERSION=1.0.0
