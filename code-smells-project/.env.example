# Copie para .env e preencha. Nunca versione o .env real.

# development | production (padrão: production)
APP_ENV=development

# Obrigatório. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Banco SQLite
DB_PATH=loja.db

# Validade do token de login (segundos)
TOKEN_MAX_AGE_SECONDS=28800

# Origens liberadas no CORS (lista separada por vírgula, ou *)
CORS_ORIGINS=*

# Conta administradora criada no boot. Obrigatórias em produção.
# Em development, sem valores, usa admin@loja.com / admin123 (somente desenvolvimento).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Produtos e clientes de demonstração (ignorado em production)
SEED_DEMO_DATA=true

# Habilita POST /admin/reset-db (ignorado em production)
ENABLE_RESET_DB=false
