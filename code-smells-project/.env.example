# Copie para .env e preencha. O .env real NÃO é versionado.

# Obrigatório em produção (APP_ENV=production): sem ele o boot falha.
# Em desenvolvimento, se vazio, é gerado um valor aleatório por processo.
SECRET_KEY=

# development | production
APP_ENV=development

HOST=127.0.0.1
PORT=5000
DEBUG=false

DATABASE_PATH=loja.db
CORS_ORIGINS=*

# Token das rotas /admin/* (Authorization: Bearer <token>). Vazio = rotas
# administrativas desabilitadas (403). Sempre desabilitadas em APP_ENV=production.
ADMIN_TOKEN=

APP_VERSION=1.0.0
