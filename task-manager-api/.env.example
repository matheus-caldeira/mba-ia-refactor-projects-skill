# Copie para .env e preencha. Nunca versione o .env.

# Obrigatório. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production | test
APP_ENV=development
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Validade do token de login, em segundos
TOKEN_MAX_AGE=28800
# Origens liberadas para CORS, separadas por vírgula ("*" = todas)
CORS_ORIGINS=*

# Conta administradora criada pelo seed. Obrigatórias em produção.
# Fora de produção, sem elas o seed usa a conta de exemplo (somente desenvolvimento).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
