# Ambiente: development | production
APP_ENV=development

# Obrigatório em produção (a app não sobe sem). Em desenvolvimento, se ausente,
# é gerado um valor efêmero em memória. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Banco de dados (default: sqlite em instance/tasks.db)
DATABASE_URL=

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# CORS: lista separada por vírgula. Vazio em produção = nenhuma origem liberada.
CORS_ORIGINS=

# Validade do token de sessão emitido pelo /login, em segundos
TOKEN_TTL_SECONDS=3600

# SMTP — nenhuma credencial fica no código
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Conta administradora garantida no boot. OBRIGATÓRIAS com APP_ENV=production
# (o boot falha sem elas). Fora de produção são opcionais.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Senha das contas de exemplo do seed.py (default dev-password-123, SOMENTE para
# desenvolvimento). O seed.py se recusa a rodar com APP_ENV=production.
SEED_PASSWORD=
