# Copie para .env e preencha. NUNCA versione o .env preenchido.

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Banco de dados ---
# Caminho do arquivo SQLite. ":memory:" recria a base a cada boot (default de dev).
DATABASE_PATH=:memory:

# --- Gateway de pagamento ---
# OBRIGATÓRIO quando NODE_ENV=production (a app falha no boot se ausente).
# A chave "pk_live_..." que estava hardcoded no código está COMPROMETIDA: rotacione.
PAYMENT_GATEWAY_KEY=

# --- Autenticacao das rotas administrativas ---
# OBRIGATÓRIO quando NODE_ENV=production (a app falha no boot se ausente).
ADMIN_API_TOKEN=

# --- Seed de desenvolvimento ---
# Senha do usuário criado no seed inicial.
SEED_USER_PASSWORD=
