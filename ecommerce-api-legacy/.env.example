# Copie para .env e preencha. Nunca versione o .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Caminho do arquivo SQLite; ":memory:" recria o banco (e o seed) a cada boot
DB_PATH=:memory:

# Obrigatórios (o boot falha sem eles)
PAYMENT_GATEWAY_KEY=
# Segredo para assinar os tokens de acesso (>= 32 caracteres aleatórios)
AUTH_SECRET=
TOKEN_TTL_SECONDS=3600

# Conta administradora. Obrigatórios em produção; em desenvolvimento,
# se vazios, usa admin@lms.local / admin-dev-only (SOMENTE desenvolvimento).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
