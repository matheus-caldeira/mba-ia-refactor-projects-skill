@baseUrl = http://localhost:3000

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Login (admin de desenvolvimento)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@lms.local",
  "password": "admin-dev-only"
}

### Relatório financeiro administrativo (exige admin)
GET {{baseUrl}}/api/admin/financial-report
Authorization: Bearer {{login.response.body.token}}

### Deletar usuário (admin ou o próprio usuário)
DELETE {{baseUrl}}/api/users/1
Authorization: Bearer {{login.response.body.token}}
